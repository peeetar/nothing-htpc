# Agent scratch: `git worktree add` targets land here and are not part of the
# project. Committing one nests a whole second checkout inside this one.
.claude/worktrees/

# Per-box config. The repo is run in place, so this is how local decisions
# (coordinates, app choices) survive a git pull. server.py prefers it over
# server/config.json when it exists.
server/config.local.json

# The old ee3 catalogue cache and its credentials. Both are gone as of the
# July 2026 remodel — the catalogue is a live Cinemeta call with an in-memory
# TTL, and there is no login anywhere any more. Kept ignored so an old working
# copy that still has these files does not offer them up on the next commit.
server/ee3.env
*.tsv.tmp
cabletv/library.tsv
